# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: NUNCA lo subas al repositorio.
#
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Todo lo demás vive exclusivamente en el servidor.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave con permisos totales que SALTA ROW LEVEL SECURITY.
# La usa solo el webhook de Vapi, que no tiene sesión de usuario.
# Si se filtra al cliente, cualquiera puede leer los datos de todas las clínicas.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Vapi — Dashboard > Settings > API Keys (usa la clave PRIVADA, no la pública)
# -----------------------------------------------------------------------------
VAPI_API_KEY=

# Secreto compartido del webhook. Se envía a Vapi como `server.secret` al publicar
# el asistente, y Vapi lo devuelve en cada petición en la cabecera `x-vapi-secret`.
# Genera uno con (Node ya es requisito del proyecto, así que esto funciona igual
# en Windows, macOS y Linux):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En macOS o Linux también sirve: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# --- Autenticación HMAC (opcional, más segura que el secreto compartido) ------
# Vapi solo ofrece HMAC a través de Custom Credentials (Dashboard > Custom
# Credentials), donde TÚ eliges el nombre de la cabecera de firma. No existe un
# `x-vapi-signature` fijo, por eso el nombre es configurable aquí.
# Deja ambas vacías para usar solo el secreto compartido.
VAPI_WEBHOOK_HMAC_HEADER=
VAPI_WEBHOOK_HMAC_SECRET=

# ID de la Custom Credential a asociar al asistente en lugar del secreto inline.
# Opcional: si se define, se publica `server.credentialId` en vez de `server.secret`.
VAPI_SERVER_CREDENTIAL_ID=

# --- Valores por defecto del agente (personalizables por clínica en el panel) --
VAPI_DEFAULT_MODEL=gpt-4.1
VAPI_DEFAULT_MODEL_PROVIDER=openai
# Azure es un proveedor de voz integrado en Vapi: no requiere conectar
# credenciales propias. Otras opciones en español: es-MX-JorgeNeural, es-ES-ElviraNeural
VAPI_DEFAULT_VOICE_PROVIDER=azure
VAPI_DEFAULT_VOICE_ID=es-MX-DaliaNeural
# nova-2 tiene soporte dedicado de español. Para atención bilingüe usa
# VAPI_DEFAULT_TRANSCRIBER_MODEL=nova-3 con VAPI_DEFAULT_LANGUAGE=multi
VAPI_DEFAULT_TRANSCRIBER=deepgram
VAPI_DEFAULT_TRANSCRIBER_MODEL=nova-2
VAPI_DEFAULT_LANGUAGE=es

# -----------------------------------------------------------------------------
# Google Calendar — Google Cloud Console > APIs & Services > Credentials
# Tipo de credencial: "OAuth client ID" > "Web application"
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" del cliente OAuth.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# URL pública de la app. En desarrollo es la URL de ngrok, porque Vapi necesita
# alcanzar el webhook desde internet. Sin barra final.
APP_URL=http://localhost:3000

# Clave de cifrado AES-256-GCM para los tokens de Google guardados en la base de
# datos. Deben ser exactamente 32 bytes en hexadecimal (64 caracteres).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En macOS o Linux también sirve: openssl rand -hex 32
# Si la cambias, los tokens ya guardados dejan de poder descifrarse y las
# clínicas tendrán que reconectar Google Calendar.
ENCRYPTION_KEY=
